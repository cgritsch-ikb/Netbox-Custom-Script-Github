# Must be reachable from inside the runner container.
GITEA_INSTANCE_URL=http://host.docker.internal:3000/

# Create an Actions runner registration token in Gitea.
GITEA_RUNNER_REGISTRATION_TOKEN=replace-with-registration-token

GITEA_RUNNER_NAME=local-ansible-runner
GITEA_RUNNER_LABELS=ubuntu-latest:docker://node:20-bookworm
